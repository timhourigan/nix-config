{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    extends: ["config:recommended"],
    semanticCommits: "enabled",
    assignees: ["timhourigan"],

    // Keep flake.lock inputs up to date via `nix flake update`, weekly.
    // rebaseWhen "never" so the PR is created once and left alone, instead
    // of Renovate silently force-pushing a new hash into it whenever
    // upstream moves again before it's merged.
    nix: {
        enabled: true,
        schedule: ["before 6am on thursday"],
        rebaseWhen: "never",
    },

    customManagers: [
        {
            // Container image versions are centralised in hosts/common/options.nix
            // under custom.images.*, so this is the only file that needs scanning.
            customType: "regex",
            fileMatch: ["^hosts/common/options\\.nix$"],
            matchStrings: [
                'default = "(?<depName>[^:"]+):(?<currentValue>[^"]+)";\\s*\\n\\s*description = "[^"]*container image"',
            ],
            datasourceTemplate: "docker",
        },
    ],

    packageRules: [
        {
            // Group Pi-hole and Nebula-Sync PRs.
            groupName: "pihole & nebula-sync",
            matchPackageNames: [
                "docker.io/pihole/pihole",
                "ghcr.io/lovelaze/nebula-sync",
            ],
        },
        {
            // Ignore Home Assistant .0 releases.
            matchPackageNames: ["ghcr.io/home-assistant/home-assistant"],
            allowedVersions: "!/\\.0$/",
        },
        {
            // nixpkgs-pinned is deliberately pinned to a specific rev for
            // zigbee2mqtt compatibility (see comment in flake.nix) and is
            // bumped manually, not by Renovate.
            matchManagers: ["nix"],
            matchDepNames: ["nixpkgs-pinned"],
            enabled: false,
        },
    ],
}
